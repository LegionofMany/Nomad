NODE_ENV=production
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000
ENABLE_QUEUE=true
ENABLE_SYNC_AUDIT=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ALLOW_PRIVATE_AUDIT=false
ALLOW_PRIVATE_RPC=false
AUDITOR_USER_AGENT=Blockpages411-Auditor/8.0
AUDITOR_HTTP_TIMEOUT_MS=12000
DYNAMIC_TIMEOUT_MS=30000
MAX_PAYLOADS=30
AUDIT_WORKER_CONCURRENCY=1
AUDIT_REPORT_DIR=./backend/data/audit-reports
AUDIT_LOG_PATH=./backend/data/audit-logs/audits.jsonl
ALERT_RISK_THRESHOLD=8
ALERT_WEBHOOK_URL=

# Required before Docker production startup. Use a unique 32+ character value.
# Example generation: openssl rand -hex 32
ADMIN_API_KEY=replace-this-with-a-strong-32-plus-character-secret
ADMIN_VERDICT_DIR=./backend/data/admin-verdicts
THREAT_INTEL_DIR=./backend/data/threat-intel
CAPTURE_SCREENSHOTS=false
SCREENSHOT_DIR=./backend/data/screenshots

# v8 chain-aware read-only simulation.
# Keep disabled until trusted RPC endpoints are configured.
ENABLE_CHAIN_SIMULATION=false
RPC_TIMEOUT_MS=8000
MAX_CHAIN_SIM_TX=8
ETHEREUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
AVALANCHE_RPC_URL=
# Optional custom map: {"0x1":{"name":"Ethereum","rpcUrl":"https://..."}}
CHAIN_RPC_MAP_JSON=

# Frontend build settings.
VITE_API_BASE=http://localhost:4000
# Keep false for public user scanner. Set true only for an internal/operator build.
VITE_ENABLE_ADMIN_PANEL=false
