# Ignore workspace-specific IDE/editor settings
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Node artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
env/
venv/
.venv/

# Environment files
.env
.env.local
.env.*.local

# Logs and databases
*.log
*.sqlite3
*.db

# Build outputs
dist/
build/
coverage/

# Editor temporary files
*.bak
*.swp

# Local workspace files (not to be pushed)
execution blueprint.md
execution process.md
prompt.md
# Execution-related artifacts and variants
# Matches files containing both 'execution' and 'process' (with or without spaces)
*execution*process*
# Matches files starting with 'execution process' (space-included)
execution\ process*
# Matches execution blueprint variants
execution\ blueprint*
# Matches any file starting with 'execution' (conservative)
execution*
