{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_NOMAD_TESTNET_FAST_KDF": "1",
        "EXPO_PUBLIC_NOMAD_TESTNET_OPEN_WINDOW": "1",
        "EXPO_PUBLIC_NOMAD_DEMO_ORIGIN": "https://nomad-eight-eta.vercel.app"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
