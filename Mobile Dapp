import React, { useState } from "react";
import { View, Text, PanResponder, StyleSheet, Vibration } from "react-native";

// This component is used for:
// - Unlock confirmation
// - Conversion confirmation
// - NFC payment confirmation

export type ClockConfirmationProps = {
  targetMinutes: number; // user-defined confirmation time
  tolerance?: number; // allowed +/- minutes
  labelKey: string; // i18n key, not raw text
  onConfirm: () => void;
  onFail?: () => void;
};

export const ClockConfirmation = ({
  targetMinutes,
  tolerance = 2,
  labelKey,
  onConfirm,
  onFail,
}: ClockConfirmationProps) => {
  const [currentMinutes, setCurrentMinutes] = useState(0);

  const pan = PanResponder.create({
    onMoveShouldSetPanResponder: () => true,
    onPanResponderMove: (_, gesture) => {
      const delta = gesture.dx;
      const minutes = Math.round((delta / 300) * 60);
      setCurrentMinutes((prev) => (prev + minutes + 1440) % 1440);
    },
    onPanResponderRelease: () => {
      const diff = Math.abs(currentMinutes - targetMinutes);
      if (diff <= tolerance) {
        Vibration.vibrate(40);
        onConfirm();
      } else {
        Vibration.vibrate([20, 40, 20]);
        onFail?.();
      }
    },
  });

  return (
    <View style={styles.container} {...pan.panHandlers}>
      {/* Clock face placeholder */}
      <View style={styles.clock} />

      {/* Label uses i18n key */}
      <Text style={styles.label}>{labelKey}</Text>
    </View>
  );
};

