// LockScreen.tsx
// Clock-only unlock screen with time validation

import React, { useState, useEffect } from "react";
import { View, Animated } from "react-native";
import { ClockDial, ClockTime } from "../components/ClockDial";
import { unlockVault } from "../crypto/vault";

const UNLOCK_TOLERANCE_MINUTES = 5; // snap-based tolerance

export const LockScreen = ({ onUnlocked }: { onUnlocked: () => void }) => {
  const [time, setTime] = useState<ClockTime>({ hour: 12, minute: 0 });
  const opacity = useState(new Animated.Value(1))[0];

  useEffect(() => {
    (async () => {
      const ok = await unlockVault(time, UNLOCK_TOLERANCE_MINUTES);
      if (ok) {
        Animated.timing(opacity, {
          toValue: 0,
          duration: 400,
          useNativeDriver: true,
        }).start(onUnlocked);
      }
    })();
  }, [time]);

  return (
    <Animated.View style={{ flex: 1, opacity, justifyContent: "center", alignItems: "center" }}>
      <ClockDial value={time} onChange={setTime} />
    </Animated.View>
  );
};

