export type SwapRoute = {
  fromToken: string;
  toToken: string;
  amountIn: number;
  estimatedOut: number;
  slippageBps: number; // basis points
  gasEstimate: number; // native gas units
  network: string;
  router: string; // aggregator / contract name
};

export type SwapQuote = {
  route: SwapRoute;
  minOut: number;
  expiresAt: number;
};

export function buildSwapQuote(route: SwapRoute): SwapQuote {
  const minOut = route.estimatedOut * (1 - route.slippageBps / 10_000);

  return {
    route,
    minOut,
    expiresAt: Date.now() + 1000 * 45, // 45s validity
  };
}

export function validateSwapQuote(quote: SwapQuote): boolean {
  return Date.now() < quote.expiresAt;
}

