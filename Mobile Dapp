// ERC-20 balance reader

import { rpcCall } from "../network/RpcClient";

export async function getTokenBalance(
  rpcUrl: string,
  tokenAddress: string,
  userAddress: string
): Promise<string> {
  const balance = await rpcCall(rpcUrl, {
    method: "eth_call",
    params: [
      {
        to: tokenAddress,
        data: "0x70a08231" + userAddress.slice(2).padStart(64, "0"),
      },
      "latest",
    ],
  });

  return balance;
}

