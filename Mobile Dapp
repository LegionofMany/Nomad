// Option 3 — Safety, Limits & Emergency Controls

import React from "react";
import { View, Text, StyleSheet } from "react-native";

export type SafetyState = {
  dailySpendLimitUSD: number;
  spentTodayUSD: number;
  nfcEnabled: boolean;
  lastActivityAt: number; // timestamp
  emergencyLocked: boolean;
};

export function canSpend(amountUSD: number, state: SafetyState): boolean {
  if (state.emergencyLocked) return false;
  if (!state.nfcEnabled) return false;
  return state.spentTodayUSD + amountUSD <= state.dailySpendLimitUSD;
}

export function shouldAutoDisableNFC(state: SafetyState, now: number): boolean {
  const INACTIVITY_MS = 1000 * 60 * 30; // 30 minutes
  if (!state.nfcEnabled) return false;
  return now - state.lastActivityAt > INACTIVITY_MS;
}

export function triggerEmergencyLock(): SafetyState {
  return {
    dailySpendLimitUSD: 0,
    spentTodayUSD: 0,
    nfcEnabled: false,
    lastActivityAt: Date.now(),
    emergencyLocked: true,
  };
}

