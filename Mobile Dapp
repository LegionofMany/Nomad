export type TimePoint = {
  hour: number;   // 0–23
  minute: number; // 0–59
};

export type RecoverySlot = {
  index: number;      // 1–24
  time: TimePoint;    // user-chosen time
};

export type RecoveryProfile = {
  slots: RecoverySlot[]; // exactly 24
  createdAt: number;
};

// =============================
// recovery/EntropyChecks.ts
// Prevent weak or patterned time selections

export function validateRecoveryProfile(profile: RecoveryProfile): boolean {
  if (profile.slots.length !== 24) return false;

  const seen = new Set<string>();

  for (const slot of profile.slots) {
    const key = `${slot.time.hour}:${slot.time.minute}`;

    // No duplicates
    if (seen.has(key)) return false;
    seen.add(key);

    // No exact hours (e.g. 3:00, 7:00)
    if (slot.time.minute === 0) return false;
  }

  return true;
}

// =============================
// recovery/ClockMnemonicMap.ts
// Deterministic mapping (conceptual)

export function timeToEntropy(time: TimePoint): number {
  return time.hour * 60 + time.minute; // 0–1439
}

