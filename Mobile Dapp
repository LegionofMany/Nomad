export type Region = "US" | "EU" | "UK" | "AU" | "UAE" | "GLOBAL";

export type ConversionReminderMode = "OFF" | "SUGGEST";

export type TravelModeState = {
  enabled: boolean;
  region: Region;
  preferredStablecoin: string;
  dailyLimitUSD: number;
  nfcEnabled: boolean;
  conversionReminder: ConversionReminderMode; // Hybrid model
};

export const REGION_STABLECOINS: Record<Region, string[]> = {
  US: ["USDC", "USDT", "DAI"],
  EU: ["EURC", "EUROe", "USDC"],
  UK: ["GBPT", "USDC"],
  AU: ["USDC"],
  UAE: ["USDC", "USDT"],
  GLOBAL: ["USDC"],
};

export function resolvePreferredStablecoin(region: Region, balances: Record<string, number>): string {
  const options = REGION_STABLECOINS[region];
  for (const token of options) {
    if ((balances[token] || 0) > 0) return token;
  }
  return options[0];
}

export function shouldSuggestConversion(
  state: TravelModeState,
  balances: Record<string, number>
): boolean {
  if (!state.enabled) return false;
  if (state.conversionReminder !== "SUGGEST") return false;
  const preferred = resolvePreferredStablecoin(state.region, balances);
  return (balances[preferred] || 0) === 0;
}

