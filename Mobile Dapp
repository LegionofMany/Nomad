export type PrefundBucket = {
  stablecoin: string;
  amount: number;
  region: string;
};

export function prefundCard(
  bucket: PrefundBucket,
  amount: number
): PrefundBucket {
  if (amount > bucket.amount) {
    throw new Error("Insufficient prefunded balance");
  }

  return {
    ...bucket,
    amount: bucket.amount - amount,
  };
}

