export type NFCPayload = {
  merchantId: string;
  amountUSD: number;
  currencyHint?: string; // optional local hint
};

export type NFCContext = {
  region: Region;
  preferredToken: string;
  travelModeEnabled: boolean;
  safety: SafetyState;
};

export function validateNFCPayment(
  payload: NFCPayload,
  context: NFCContext
): { allowed: boolean; reason?: string } {
  if (!context.travelModeEnabled)
    return { allowed: false, reason: "travel_mode_required" };

  if (!canSpend(payload.amountUSD, context.safety))
    return { allowed: false, reason: "limit_or_lock" };

  return { allowed: true };
}

