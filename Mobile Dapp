// mnemonic.ts (Clock-Time Mnemonic)
// 24 clock-times mapped to 24-word BIP39 mnemonic

import * as bip39 from "bip39";
import { ClockTime } from "../components/ClockDial";

export function generateClockMnemonic(): { mnemonic: string; clocks: ClockTime[] } {
  const mnemonic = bip39.generateMnemonic(256); // 24 words
  const words = mnemonic.split(" ");

  const clocks: ClockTime[] = words.map((_, i) => ({
    hour: (i % 12) + 1,
    minute: (i * 5) % 60,
  }));

  return { mnemonic, clocks };
}

export function clocksToEntropy(clocks: ClockTime[]): Buffer {
  // Deterministic, auditable mapping
  const bytes = clocks.map(c => (c.hour * 60 + c.minute) % 256);
  return Buffer.from(bytes);
}
}

export function clocksToMnemonic(clocks: ClockTime[], wordlist: string[]): string {
  // Deterministic mapping (final mapping defined later)
  return clocks.map(c => wordlist[(c.hour * 5 + c.minute / 5) % wordlist.length]).join(" ");
}

