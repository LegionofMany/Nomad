  createdAt: number;
};

export function createSwapIntent(quote: SwapQuote): SwapIntent {
  if (!validateSwapQuote(quote)) {
    throw new Error("Quote expired");
  }

  return {
    quote,
    createdAt: Date.now(),
  };
}

