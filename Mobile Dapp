// CreateWallet.tsx
// 24-Clock Recovery Creation & Confirmation Ritual

import React, { useState } from "react";
import { View, Text, ScrollView, Animated } from "react-native";
import { ClockDial, ClockTime } from "../components/ClockDial";
import { generateClockMnemonic } from "../crypto/mnemonic";
import { setUnlockTime } from "../crypto/vault";

export const CreateWallet = ({ onComplete }: { onComplete: () => void }) => {
  const [{ clocks }, setSeed] = useState(() => generateClockMnemonic());
  const [step, setStep] = useState<"backup" | "confirm" | "unlock">("backup");
  const [index, setIndex] = useState(0);
  const [entered, setEntered] = useState<ClockTime[]>([]);
  const fade = new Animated.Value(1);

  const next = () => {
    if (step === "backup" && index === 23) {
      setStep("confirm");
      setIndex(0);
    } else if (step === "confirm" && index === 23) {
      setStep("unlock");
    } else {
      setIndex(index + 1);
    }
  };

  const onConfirm = (t: ClockTime) => {
    const updated = [...entered];
    updated[index] = t;
    setEntered(updated);
    next();
  };

  if (step === "unlock") {
    return (
      <View style={{ flex: 1, justifyContent: "center", alignItems: "center" }}>
        <Text>Set your daily unlock time</Text>
        <ClockDial value={{ hour: 12, minute: 0 }} onChange={setUnlockTime} />
        <Text onPress={onComplete}>Finish</Text>
      </View>
    );
  }

  const current = step === "backup" ? clocks[index] : undefined;

  return (
    <Animated.View style={{ flex: 1, opacity: fade, justifyContent: "center", alignItems: "center" }}>
      <Text>{step === "backup" ? `Backup Clock ${index + 1}/24` : `Confirm Clock ${index + 1}/24`}</Text>
      <ClockDial
        value={current || { hour: 12, minute: 0 }}
        onChange={step === "confirm" ? onConfirm : next}
      />
    </Animated.View>
  );
}
// vault.ts
// Encrypted local vault using user-selected unlock time

import * as SecureStore from "expo-secure-store";
import { ClockTime } from "../components/ClockDial";

const VAULT_KEY = "NOMAD_VAULT";
const UNLOCK_KEY = "NOMAD_UNLOCK_TIME";

function minutes(t: ClockTime) {
  return (t.hour % 12) * 60 + t.minute;
}

export async function setUnlockTime(time: ClockTime) {
  await SecureStore.setItemAsync(UNLOCK_KEY, JSON.stringify(time));
}

export async function unlockVault(input: ClockTime, tolerance: number): Promise<boolean> {
  const stored = await SecureStore.getItemAsync(UNLOCK_KEY);
  if (!stored) return false;

  const target: ClockTime = JSON.parse(stored);
  const diff = Math.abs(minutes(input) - minutes(target));

  return diff <= tolerance;
}

// ClockDial.tsx
// Bezel-rotation style interaction (safe-dial inspired)
// Clock-only UI until unlock

import React, { useRef, useState } from "react";
import { View, StyleSheet, PanResponder, Vibration } from "react-native";

export type ClockTime = {
  hour: number;   // 1–12
  minute: number; // multiples of 5
};

const SNAP_MINUTES = 5;
const FULL_ROTATION = 360;

function angleToTime(angle: number): ClockTime {
  const normalized = (angle + 360) % 360;
  const totalMinutes = Math.round((normalized / 360) * 720 / SNAP_MINUTES) * SNAP_MINUTES;
  const hour = Math.floor(totalMinutes / 60) % 12 || 12;
  const minute = totalMinutes % 60;
  return { hour, minute };
}

export const ClockDial: React.FC<{
  value: ClockTime;
  onChange: (t: ClockTime) => void;
}> = ({ value, onChange }) => {
  const angleRef = useRef(0);
  const [angle, setAngle] = useState(0);

  const panResponder = useRef(
    PanResponder.create({
      onStartShouldSetPanResponder: () => true,
      onPanResponderMove: (_, gesture) => {
        const rotation = gesture.dx; // horizontal bezel drag
        const newAngle = angleRef.current + rotation;
        const snapped = Math.round(newAngle / (FULL_ROTATION / (720 / SNAP_MINUTES))) * (FULL_ROTATION / (720 / SNAP_MINUTES));
        angleRef.current = snapped;
        setAngle(snapped);
        const time = angleToTime(snapped);
        onChange(time);
        Vibration.vibrate(5);
      },
      onPanResponderRelease: () => {
        angleRef.current = angle;
      },
    })
  ).current;

  return (
    <View style={styles.container}>
      <View
        {...panResponder.panHandlers}
        style={[styles.bezel, { transform: [{ rotate: `${angle}deg` }] }]}
      />
      <View style={styles.centerPin} />
    </View>
  );
};

