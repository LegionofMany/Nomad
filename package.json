{
  "name": "nomad",
  "version": "0.1.0",
  "private": true,
  "description": "Nomad Wallet monorepo with Vercel beta site, wallet modules, and Android-native scaffold",
  "scripts": {
    "dev": "npm run build",
    "build": "node -e \"console.log('Nomad beta static site ready')\"",
    "start": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "audit:nomad": "npm run typecheck && npm run mobile:typecheck"
  },
  "dependencies": {
    "@scure/bip39": "^1.0.0",
    "bip32": "^2.0.6",
    "bitcoinjs-lib": "^6.1.0",
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
